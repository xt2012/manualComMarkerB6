                <index Value="0"/>
                <name Value=""/>
                <LinkPath Value="Copper/SmallTracksCopperRemoval/0.2mm Tracks tested."/>
                <maxPower Value="95"/>
                <maxPower2 Value="20"/>
                <speed Value="867"/>
                <frequency Value="27750"/>
                <QPulseWidth Value="50"/>
                <numPasses Value="10"/>
                <bidir Value="0"/>
                <crossHatch Value="1"/>
                <dotWidth Value="0.015"/>
                <useDotCorrection Value="1"/>
                <interval Value="0.015"/>
                <angle Value="45"/>
                <priority Value="0"/>
                <tabCount Value="1"/>
                <tabCountMax Value="1"/>
            </CutSetting>
        </Entry>
        <Entry Thickness="-1.0000" Desc="0.2mm Tracks tested." NoThickTitle="SmallTracksCopperRemovalFinish">
            <CutSetting type="Scan">
                <index Value="0"/>
                <name Value=""/>
                <LinkPath Value="Copper/SmallTracksCopperRemovalFinish/0.2mm Tracks tested."/>
