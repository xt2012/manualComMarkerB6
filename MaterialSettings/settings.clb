                <useDotCorrection Value="1"/>
                <interval Value="0.015"/>
                <angle Value="45"/>
                <priority Value="0"/>
                <hide Value="1"/>
                <tabCount Value="1"/>
                <tabCountMax Value="1"/>
            </CutSetting>
        </Entry>
        <Entry Thickness="-1.0000" Desc="Cutting" NoThickTitle="CopperBoardCutting">
            <CutSetting type="Cut">
                <index Value="0"/>
                <name Value=""/>
                <LinkPath Value="Copper/CopperBoardCutting/Cutting"/>
                <maxPower Value="80"/>
                <maxPower2 Value="20"/>
                <speed Value="50"/>
                <numPasses Value="60"/>
                <priority Value="0"/>
                <tabCount Value="1"/>
