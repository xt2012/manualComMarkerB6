<?xml version="1.0" encoding="UTF-8"?>
<LightBurnLibrary DisplayName="settings">
    <Material name="Copper">
        <Entry Thickness="-1.0000" Desc="remove copper" NoThickTitle="18um">
            <CutSetting type="Scan">
                <index Value="0"/>
                <name Value=""/>
                <LinkPath Value="Copper/18um/remove copper"/>
                <maxPower Value="95"/>
                <maxPower2 Value="20"/>
                <speed Value="867"/>
                <frequency Value="27750"/>
                <QPulseWidth Value="100"/>
                <numPasses Value="15"/>
                <anglePerPass Value="90"/>
                <interval Value="0.04"/>
                <priority Value="0"/>
                <tabCount Value="1"/>
                <tabCountMax Value="1"/>
            </CutSetting>
        </Entry>
        <Entry Thickness="-1.0000" Desc="18um border finish. Straight cut edges." NoThickTitle="CopperBorderFinish">
            <CutSetting type="Cut">
                <index Value="0"/>
                <name Value=""/>
                <LinkPath Value="Copper/CopperBorderFinish/18um border finish. Straight cut edges."/>
                <maxPower Value="100"/>
                <maxPower2 Value="20"/>
                <speed Value="1500"/>
                <frequency Value="27750"/>
                <QPulseWidth Value="25"/>
                <numPasses Value="300"/>
                <priority Value="0"/>
                <tabCount Value="1"/>
                <tabCountMax Value="1"/>
            </CutSetting>
        </Entry>
        <Entry Thickness="-1.0000" Desc="0.2mm Tracks tested." NoThickTitle="SmallTracksCopperRemoval">
